# PANDA SDK Configuration Example
# Copy this file to .env and update with your values

# ============================================================
# KEY PROVIDER SELECTION
# ============================================================
# Options: local, vault, infisical
PANDA_KEY_PROVIDER_DRIVER=local

# ============================================================
# LOCAL KEY PROVIDER (Development Only)
# ============================================================
# Keys are stored as base64-encoded 32-byte values
# Generate with: openssl rand -base64 32
PANDA_KEY_DEFAULT_KEY=
PANDA_KEY_NIK_KEY=
PANDA_KEY_PHONE_KEY=
PANDA_DEFAULT_KID=default-key

# ============================================================
# INFISICAL KEY PROVIDER
# ============================================================
# Sign up at https://infisical.com (free tier available)
# Create Machine Identity and get Client ID/Secret
# PANDA_INFISICAL_SITE_URL=https://app.infisical.com
# PANDA_INFISICAL_CLIENT_ID=
# PANDA_INFISICAL_CLIENT_SECRET=
# PANDA_INFISICAL_PROJECT_ID=
# PANDA_INFISICAL_ENVIRONMENT=dev
# PANDA_INFISICAL_CACHE_TTL=300

# ============================================================
# HASHICORP VAULT KEY PROVIDER
# ============================================================
# Requires Vault server with KV v2 secrets engine enabled
# PANDA_VAULT_URL=http://localhost:8200
# PANDA_VAULT_TOKEN=
# PANDA_VAULT_MOUNT_PATH=secret
# PANDA_VAULT_NAMESPACE=
# PANDA_VAULT_INSECURE=false

# ============================================================
# AUDIT LOGGING (Optional)
# ============================================================
# Log decryptRaw() calls for audit trail
# PANDA_AUDIT_LOG_ENABLED=true
# PANDA_AUDIT_LOG_PATH=./panda-audit.log

# ============================================================
# MIGRATION (Optional)
# ============================================================
# For database migration operations
# PANDA_MIGRATION_BATCH_SIZE=100
# PANDA_MIGRATION_DELAY=100

# ============================================================
# PYTHON-SPECIFIC CONFIGURATION
# ============================================================
# For Django/Flask/FastAPI, can also use JSON config:
# PANDA_CONFIG={"key_provider_driver": "local", "default_kid": "default-key"}

# ============================================================
# NOTES
# ============================================================
# - Never commit .env file to version control
# - Use different keys for different environments (dev, staging, prod)
# - For production, always use Vault or Infisical, never Local
# - Generate secure keys: openssl rand -base64 32
# - Rotate keys regularly (recommended: annually)
# - For Python, load .env with python-dotenv or os.getenv()
# - After updating .env, restart your Python application
